# NEMESIS-X Backend Environment Configuration
APP_NAME=NEMESIS-X
APP_DESCRIPTION=Beyond Detection. Into Understanding.
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite Database Configuration
DATABASE_URL=sqlite:///./nemesis.db

# JWT Security Configuration (replace SECRET_KEY in your local .env)
SECRET_KEY=replace-with-a-long-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local Storage Paths
STORAGE_ROOT=../storage
UPLOAD_DIR=../storage/uploads
PROCESSED_DIR=../storage/processed
EVIDENCE_DIR=../storage/evidence
REPORTS_DIR=../storage/reports
PLAYBACK_DIR=../storage/playback

# CPU-Only Object Detection Settings
YOLO_MODEL_NAME=yolo11n.pt
DETECTION_CONFIDENCE=0.40
DETECTION_IMAGE_SIZE=416
DETECTION_DEVICE=cpu
