# ==========================================
# NEMESIS-X Environment Configuration
# ==========================================

# Application Settings
APP_NAME=NEMESIS-X
APP_ENV=development
DEBUG=true

# Server & Frontend URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# AI / Vision-Language Model API Keys
LLM_API_KEY=your_llm_api_key_here
VLM_MODEL_NAME=your_vlm_model_here

# Detection & Temporal Analysis Settings
DETECTION_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
FRAME_SAMPLE_FPS=2
TEMPORAL_WINDOW_SECONDS=10

# Bilingual Alert Settings
ALERT_LANGUAGES=en,kn
DEFAULT_ALERT_LANGUAGE=en

# Local Storage Paths
STORAGE_ROOT=./storage
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
EVIDENCE_DIR=./storage/evidence
REPORTS_DIR=./storage/reports
